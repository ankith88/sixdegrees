# SixDegrees v2.4 Spatial 3D Engine - Multi-API & Cloud Firestore Configuration
# Copy this file to .env.local and fill in your keys.
# IMPORTANT: Do NOT prefix with NEXT_PUBLIC_ so keys stay strictly on the server and are never exposed to the browser.

TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
OMDB_API_KEY=

# Cloud Firestore Free-Tier Persistent Catalog Cache (Spark Plan: 50k reads/day, 20k writes/day)
# Option A (Recommended - Simple): Provide your Firebase Project ID and Web API Key
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Option B (Optional - Service Account): For locked-down Admin SDK / REST Bearer authentication
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


